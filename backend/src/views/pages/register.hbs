<header>
  <h1><a href="/" style="color: var(--accent); text-decoration: none;">Quiz</a></h1>
  <nav>
    {{#if user}}
      <a href="/profile">{{user.username}}</a>
      {{#if isAdmin}}<a href="/admin">⚙ Panel</a>{{/if}}
    {{else}}
      <a href="/login">Iniciar sesión</a>
    {{/if}}
  </nav>
</header>

<div class="container">
  <h2>Crear cuenta</h2>

  {{#if error}}<p class="error">{{error}}</p>{{/if}}

  <form action="/api/auth/register" method="POST" class="card">
    {{#if redirect}}<input type="hidden" name="redirect" value="{{redirect}}">{{/if}}
    <div class="form-group">
      <label for="username">Usuario</label>
      <input type="text" id="username" name="username" value="{{values.username}}" required minlength="3" maxlength="30" pattern="[a-zA-Z0-9_]+">
      <small class="muted">3-30 caracteres, alfanuméricos o _</small>
    </div>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="{{values.email}}" required>
    </div>
    <div class="form-group">
      <label for="name">Nombre (opcional)</label>
      <input type="text" id="name" name="name" value="{{values.name}}">
    </div>
    <div class="form-group">
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required minlength="8">
      <small class="muted">Mínimo 8 caracteres</small>
    </div>
    <button type="submit">Registrarse</button>
    <p class="muted" style="margin-top:1rem;">¿Ya tienes cuenta? <a href="/login{{#if redirect}}?redirect={{redirect}}{{/if}}">Inicia sesión</a></p>
  </form>
</div>
